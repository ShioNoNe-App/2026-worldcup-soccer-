name: Daily World Cup Promotion

on:
  schedule:
    # 毎日午前9時（日本時間）に実行 (UTC 0:00)
    - cron: '0 0 * * *'
  workflow_dispatch: # 手動実行用（テスト用）

jobs:
  promote:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install openai requests requests-oauthlib

      - name: Generate Promotion and Post to X
        env:
          OPENAI_API_KEY: <LaTex>${{ secrets.OPENAI_API_KEY }}
          X_API_KEY: $</LaTex>{{ secrets.X_API_KEY }}
          X_API_SECRET: <LaTex>${{ secrets.X_API_SECRET }}
          X_ACCESS_TOKEN: $</LaTex>{{ secrets.X_ACCESS_TOKEN }}
          X_ACCESS_SECRET: ${{ secrets.X_ACCESS_SECRET }}
        run: python scripts/promote_and_post.py
